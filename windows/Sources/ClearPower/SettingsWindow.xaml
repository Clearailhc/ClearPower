<Window x:Class="ClearPower.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClearPower" Width="520" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="GroupTitle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Sub">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="Border" x:Key="Row">
            <Setter Property="Background" Value="{DynamicResource BoxBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,6,20,20">
        <TextBlock x:Name="TTop" Style="{StaticResource GroupTitle}" />
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <ComboBox x:Name="PanelText" DockPanel.Dock="Right" SelectionChanged="OnPanelText" />
                <TextBlock x:Name="LPanelText" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <ComboBox x:Name="Flow" DockPanel.Dock="Right" SelectionChanged="OnFlow" />
                <StackPanel>
                    <TextBlock x:Name="LFlow" />
                    <TextBlock x:Name="LFlowSub" Style="{StaticResource Sub}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <ComboBox x:Name="Lang" DockPanel.Dock="Right" SelectionChanged="OnLang" />
                <TextBlock x:Name="LLang" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <CheckBox x:Name="Login" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnLogin" />
                <TextBlock x:Name="LLogin" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock x:Name="TCharge" Style="{StaticResource GroupTitle}" />
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="LimitSlider" Width="160" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" SmallChange="1" LargeChange="10" ValueChanged="OnLimitSlider" VerticalAlignment="Center" />
                    <TextBlock x:Name="LimitValue" Width="42" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="LLimit" />
                    <TextBlock x:Name="LLimitSub" Style="{StaticResource Sub}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <TextBlock x:Name="LChargeStatus" />
                <TextBlock x:Name="LChargeSub" Style="{StaticResource Sub}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="TRuntime" Style="{StaticResource GroupTitle}" />
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <ComboBox x:Name="Win" DockPanel.Dock="Right" SelectionChanged="OnWin" />
                <StackPanel>
                    <TextBlock x:Name="LWin" />
                    <TextBlock x:Name="LWinSub" Style="{StaticResource Sub}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="TDisplay" Style="{StaticResource GroupTitle}" />
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <CheckBox x:Name="ContentAware" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnContent" />
                <StackPanel>
                    <TextBlock x:Name="LContent" />
                    <TextBlock x:Name="LContentSub" Style="{StaticResource Sub}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <Button x:Name="CalBtn" DockPanel.Dock="Right" Padding="14,4" VerticalAlignment="Center" Click="OnCalibrate" />
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="LCal" />
                    <TextBlock x:Name="LCalSub" Style="{StaticResource Sub}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <TextBlock x:Name="CalStatus" />
                <TextBlock x:Name="CalMessage" Style="{StaticResource Sub}" Foreground="{DynamicResource WarnBrush}" />
                <TextBlock x:Name="LEstimate" Style="{StaticResource Sub}" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="About" Style="{StaticResource Sub}" Margin="0,12,0,0" HorizontalAlignment="Center" />
    </StackPanel>
    </ScrollViewer>
</Window>
