<Application x:Class="ClearPower.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Palette (replaced at runtime by Theme.Refresh) -->
        <SolidColorBrush x:Key="BgBrush" Color="#202020" />
        <SolidColorBrush x:Key="FgBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="DimBrush" Color="#E6A0A0A0" />
        <SolidColorBrush x:Key="PillBrush" Color="#29808080" />
        <SolidColorBrush x:Key="PillHoverBrush" Color="#47808080" />
        <SolidColorBrush x:Key="CheckedBrush" Color="#665C99EB" />
        <SolidColorBrush x:Key="BoxBrush" Color="#1F808080" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30FFFFFF" />
        <SolidColorBrush x:Key="WarnBrush" Color="#E07A5F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5C99EB" />

        <!-- Rounded "pill" button (charge limit) -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource PillBrush}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small pill (runtime window) -->
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,1" />
        </Style>

        <!-- Icon-only button (settings) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- Toggle chip (discharge / top up) -->
        <Style x:Key="ToggleChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource PillBrush}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CheckedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle icon (power modes) -->
        <Style x:Key="ToggleIcon" TargetType="ToggleButton" BasedOn="{StaticResource ToggleChip}">
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Application.Resources>
</Application>
