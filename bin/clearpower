#!/usr/bin/env python3
"""ClearPower launcher: enables the GNOME Shell extension for the current user and opens its settings.

  clearpower              enable (if needed) and open the extension preferences
  clearpower enable       enable the top-bar indicator for this user
  clearpower disable      disable it
  clearpower status       show daemon + extension status
  clearpower --autostart  called from the XDG autostart entry: enable once per user, silently
"""
import os
import subprocess
import sys

UUID = "clearpower@lhc"
MARK = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                    "clearpower", "extension-enabled-once")
STALE_USER_COPY = os.path.expanduser(f"~/.local/share/gnome-shell/extensions/{UUID}")


def run(*args, check=False):
    return subprocess.run(args, text=True, capture_output=True, check=check)


def is_gnome():
    return "GNOME" in os.environ.get("XDG_CURRENT_DESKTOP", "").upper()


def ext_state():
    r = run("gnome-extensions", "info", UUID)
    if r.returncode != 0:
        return None
    enabled = any(l.strip().endswith(("是", "Yes")) and ("启用" in l or "Enabled" in l) for l in r.stdout.splitlines())
    return "enabled" if enabled else "disabled"


def enable(quiet=False):
    if not is_gnome():
        if not quiet:
            print("ClearPower's indicator is a GNOME Shell extension; this desktop is not GNOME.")
        return 1
    if os.path.isdir(STALE_USER_COPY) and os.path.isdir(f"/usr/share/gnome-shell/extensions/{UUID}"):
        if not quiet:
            print(f"note: a per-user copy at {STALE_USER_COPY} shadows the packaged extension; "
                  "remove it (rm -r) and log in again to use the packaged one.")
    state = ext_state()
    if state is None:
        if not quiet:
            print("GNOME Shell has not loaded the ClearPower extension yet. Log out and back in, then run `clearpower` again.")
        return 2
    if state == "enabled":
        return 0
    r = run("gnome-extensions", "enable", UUID)
    if r.returncode != 0:
        if not quiet:
            print(r.stderr.strip() or "enable failed")
        return r.returncode
    if not quiet:
        print("ClearPower indicator enabled in the top bar.")
    return 0


def autostart():
    if os.path.exists(MARK):
        return 0
    rc = enable(quiet=True)
    if rc == 0:
        os.makedirs(os.path.dirname(MARK), exist_ok=True)
        open(MARK, "w").close()
    return 0


def status():
    d = run("systemctl", "is-active", "clearpowerd").stdout.strip() or "unknown"
    print(f"daemon:    clearpowerd {d}")
    print(f"extension: {ext_state() or 'not loaded by GNOME Shell (log in again)'}")
    r = run("busctl", "--system", "get-property", "org.clearpower.Daemon1", "/org/clearpower/Daemon",
            "org.clearpower.Daemon1", "ChargeLimit")
    if r.returncode == 0:
        print(f"limit:     {r.stdout.split()[-1]}%")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "--autostart":
        return autostart()
    if cmd == "enable":
        return enable()
    if cmd == "disable":
        return run("gnome-extensions", "disable", UUID).returncode
    if cmd == "status":
        return status()
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    rc = enable()
    if rc == 0:
        subprocess.Popen(["gnome-extensions", "prefs", UUID], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv))
