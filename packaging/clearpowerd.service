[Unit]
Description=ClearPower power monitor and charge control daemon
After=multi-user.target

[Service]
Type=dbus
BusName=org.clearpower.Daemon1
ExecStart=/usr/bin/python3 -m clearpowerd
Environment=PYTHONPATH=/usr/lib/clearpower
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
StateDirectory=clearpower
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=graphical.target
